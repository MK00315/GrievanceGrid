{
  "name": "grievancegrid",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "web": "npm run dev --workspace=@grievancegrid/web",
    "mobile": "npm run start --workspace=@grievancegrid/mobile",
    "build:web": "npm run build --workspace=@grievancegrid/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test packages/api-client/tests/*.test.ts"
  }
}
