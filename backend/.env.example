# Lightweight local demo. Docker Compose supplies PostgreSQL instead.
GG_DATABASE_URL=sqlite:///./var/grievancegrid.db
GG_JURISDICTION_ID=demo-municipality
GG_JURISDICTION_NAME=Demo municipality (simulated)
GG_CORS_ORIGINS=["http://localhost:3000"]
GG_STORAGE_BACKEND=local
GG_LOCAL_STORAGE_PATH=./var/evidence
GG_SESSION_HOURS=8
# For private S3 storage: set backend=s3 and supply endpoint, bucket and credentials locally.
# GG_S3_ENDPOINT_URL=http://localhost:9000
# GG_S3_BUCKET=grievancegrid-evidence
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
